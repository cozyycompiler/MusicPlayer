
            <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Music Heart</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            height: 100vh;
            overflow: hidden;

            background: #050505;

            font-family: Arial, sans-serif;
        }

        /* MUSIC PLAYER */

        .player {
            position: fixed;

            top: 15px;
            left: 50%;

            transform: translateX(-50%);

            width: 92%;
            max-width: 600px;

            padding: 15px;

            background: rgba(20, 20, 20, 0.95);

            border: 1px solid #333;

            border-radius: 15px;

            z-index: 10;
        }

        .song-name {
            color: white;

            text-align: center;

            margin-bottom: 10px;

            font-size: 15px;
        }

        audio {
        width: 100%;
            height: 40px;
        }

        /* HEART */

        canvas {
            display: block;

            width: 100%;
            height: 100%;
        }
    </style>
</head>

<body>


    <!-- =====================================
         MUSIC PLAYER
         PUT YOUR MP3 LINK BELOW
    ====================================== -->

    <div class="player">

        <div class="song-name">
            My Song
        </div>

        <audio
            id="music" controls>

            <!-- PASTE YOUR MP3 LINK HERE -->

            <source
                src="peach eyes.mp3"
                type="audio/mpeg">

            Your browser does not support audio.

        </audio>

    </div>


    <!-- HEART -->

    <canvas id="canvas"></canvas>


    <script>

        /* =====================================
           CANVAS
        ====================================== */

        const canvas =
            document.getElementById("canvas");

        const ctx =
            canvas.getContext("2d");


        const music =
            document.getElementById("music");


        function resize() {

            canvas.width =
                window.innerWidth;

            canvas.height =
                window.innerHeight;

        }


        resize();


        window.addEventListener(
            "resize",
            resize
        );


        /* =====================================
           AUDIO ANALYSER
        ====================================== */

        let audioContext = null;

        let analyser = null;

        let dataArray = null;


        function setupAudio() {

            if (audioContext) {
                return;
            }


            audioContext =
                new (
                    window.AudioContext ||
                    window.webkitAudioContext
                )();


            const source =
                audioContext
                .createMediaElementSource(
                    music
                );


            analyser =
                audioContext
                .createAnalyser();


            analyser.fftSize = 256;


            source.connect(
                analyser
            );


            analyser.connect(
                audioContext.destination
            );


            dataArray =
                new Uint8Array(
                    analyser.frequencyBinCount
                );

        }


        music.addEventListener(
            "play",
            function() {

                setupAudio();

                if (
                    audioContext.state ===
                    "suspended"
                ) {

                    audioContext.resume();

                }

            }
        );


        /* =====================================
           HEART DOTS
        ====================================== */

        const dots = [];

        const DOT_COUNT = 700;


        function createHeart() {

            dots.length = 0;


            const scale =
                Math.min(
                    canvas.width,
                    canvas.height
                ) * 0.018;


            for (
                let i = 0;
                i < DOT_COUNT;
                i++
            ) {

                const t =
                    Math.random() *
                    Math.PI * 2;


                /*
                 * Heart equation
                 */

                const heartX =
                    16 *
                    Math.pow(
                        Math.sin(t),
                        3
                    );


                const heartY =
                    -(
                        13 * Math.cos(t)
                        - 5 * Math.cos(2 * t)
                        - 2 * Math.cos(3 * t)
                        - Math.cos(4 * t)
                    );


                dots.push({

                    x:
                        canvas.width / 2 +
                        heartX * scale,

                    y:
                        canvas.height / 2 +
                        heartY * scale,

                    size:
                        Math.random() * 1.8 + 1

                });

            }

        }


        createHeart();


        window.addEventListener(
            "resize",
            createHeart
        );


        /* =====================================
           GET MUSIC VOLUME
        ====================================== */

        function getVolume() {

            if (
                !analyser ||
                music.paused
            ) {

                return 0;

            }


            analyser.getByteFrequencyData(
                dataArray
            );


            let total = 0;


            for (
                let i = 0;
                i < dataArray.length;
                i++
            ) {

                total +=
                    dataArray[i];

            }


            return (
                total /
                dataArray.length /
                255
            );

        }


        /* =====================================
           HEART ANIMATION
        ====================================== */

        let time = 0;


        function animate() {

            ctx.clearRect(
                0,
                0,
                canvas.width,
                canvas.height
            );


            time += 0.035;


            const volume =
                getVolume();


            /*
             * Natural heartbeat
             */

            const beat =
                Math.max(
                    0,
                    Math.sin(time * 2.5)
                );


            /*
             * Music controls the
             * strength of the beat.
             */

            const pulse =
                1 +
                beat * 0.025 +
                volume * 0.22;


            const centerX =
                canvas.width / 2;


            const centerY =
                canvas.height / 2;


            /* Draw every dot */

            dots.forEach(function(dot) {


                const x =
                    centerX +
                    (dot.x - centerX)
                    * pulse;


                const y =
                    centerY +
                    (dot.y - centerY)
                    * pulse;


                ctx.beginPath();


                ctx.arc(

                    x,

                    y,

                    dot.size +
                    volume * 2,

                    0,

                    Math.PI * 2

                );


                ctx.fillStyle =
                    "rgba(255, 55, 85, 0.9)";


                ctx.shadowBlur =
                    8 +
                    volume * 20;


                ctx.shadowColor =
                    "rgba(255, 30, 60, 0.8)";


                ctx.fill();

            });


            requestAnimationFrame(
                animate
            );

        }


        animate();

    </script>

</body>
  </html>
